# ─────────────────────────────────────────────────────────────────────
#  Medicis Change Control — Configuration du backend
#  Copiez ce fichier vers `.env` puis renseignez vos accès réels.
#  Le fichier `.env` est ignoré par git (jamais commité).
# ─────────────────────────────────────────────────────────────────────

# Port HTTP de l'API Express
PORT=4000

# ────────────── Connexion SQL Server : base DCMEDICIS ──────────────
# Exemple documenté : 197.13.22.67\SRVAPPINT
DB_DC_SERVER=197.13.22.67\SRVAPPINT
DB_DC_DATABASE=DCMEDICIS
DB_DC_USER=
DB_DC_PASSWORD=

# Chiffrement TLS de la connexion (false pour un serveur interne non-TLS)
DB_DC_ENCRYPT=false
DB_DC_TRUST_SERVER_CERTIFICATE=true

# Nombre max de connexions du pool
DB_DC_POOL_MAX=10

# Timeout (ms) de connexion — 0 = défaut native
DB_DC_CONNECT_TIMEOUT=15000

# ────────────── Connexion Qualipro (optionnelle, lecture seule) ──────────────
# Non utilisée pour l'instant : intégration plans d'action (table Qnet) à venir.
DB_QUALIPRO_ENABLED=false
DB_QUALIPRO_SERVER=
DB_QUALIPRO_DATABASE=Qnet
DB_QUALIPRO_USER=
DB_QUALIPRO_PASSWORD=

# ────────────── Sécurité / Session (prototype) ──────────────
# En phase prototype l'identité de l'utilisateur est transmise par le frontend
# (champ email des approbateurs / demandeur). Aucun secret requis.
# Un vrai flux JWT/OAuth sera ajouté à la mise en production.